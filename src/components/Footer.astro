---
import { BASE_PATH, GITHUB_URL, SITE_AUTHOR } from '../consts';

const year = new Date().getFullYear();
---
<footer
	class="mt-16 border-t border-zinc-200 py-8 text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400"
	data-pagefind-ignore
>
	<div
		class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-4 sm:flex-row"
	>
		<p>© {year} {SITE_AUTHOR}</p>
		<div class="flex items-center gap-4">
			<a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={`${BASE_PATH}/rss.xml`}>RSS</a>
			<a
				class="hover:text-zinc-900 dark:hover:text-zinc-100"
				href={GITHUB_URL}
				target="_blank"
				rel="noreferrer">GitHub</a
			>
			<a class="hover:text-zinc-900 dark:hover:text-zinc-100" href="https://astro.build"
				>Astro</a
			>
		</div>
	</div>
</footer>
