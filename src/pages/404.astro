---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../consts';
---
<BaseLayout title="页面不存在" description="404">
	<section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-24">
		<p class="text-sm font-medium text-blue-600 dark:text-blue-400">404</p>
		<h1 class="mt-2 text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
			页面不存在
		</h1>
		<p class="mt-4 text-zinc-600 dark:text-zinc-400">
			这个地址没有对应的页面，可能是链接写错了，或者文章已经被移动。
		</p>
		<a
			href={withBase('/')}
			class="mt-8 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
		>
			返回首页
		</a>
	</section>
</BaseLayout>
