---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../consts';
import { formatDate, getPublishedPosts, groupByYear } from '../lib/posts';

const posts = await getPublishedPosts();
const groups = groupByYear(posts);
---
<BaseLayout title="归档" description="按年份浏览全部文章">
	<section class="mx-auto max-w-3xl px-4 py-12">
		<header class="mb-8 border-b border-zinc-200 pb-6 dark:border-zinc-800">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">归档</h1>
			<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">共 {posts.length} 篇</p>
		</header>

		<div class="space-y-10">
			{
				groups.map(([year, items]) => (
					<section>
						<h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
							{year}
							<span class="ml-2 text-sm font-normal text-zinc-400 dark:text-zinc-500">
								{items.length} 篇
							</span>
						</h2>
						<ul class="mt-4 space-y-3">
							{items.map((post) => (
								<li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
									<time
										datetime={post.data.pubDate.toISOString()}
										class="shrink-0 text-xs text-zinc-400 tabular-nums dark:text-zinc-500"
									>
										{formatDate(post.data.pubDate)}
									</time>
									<a
										href={withBase(`/posts/${post.id}/`)}
										class="text-sm text-zinc-700 hover:text-blue-600 dark:text-zinc-300 dark:hover:text-blue-400"
									>
										{post.data.title}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>
