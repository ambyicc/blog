---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';
import { getAllTags, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 5);
const tags = getAllTags(posts);
---
<BaseLayout>
	<section class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:pt-24">
		<p class="text-sm font-medium text-blue-600 dark:text-blue-400">个人博客</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50">
			{SITE_TITLE}
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
			{SITE_DESCRIPTION}
		</p>

		<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
			<span>{posts.length} 篇文章</span>
			<span>{tags.length} 个标签</span>
			<a class="text-blue-600 hover:underline dark:text-blue-400" href={withBase('/posts/')}
				>浏览全部文章 →</a
			>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-4 pb-8">
		<div class="mb-5 flex items-end justify-between">
			<h2 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">最新文章</h2>
		</div>

		{
			latest.length === 0 ? (
				<p class="rounded-xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
					还没有文章，去 src/content/blog 里新建一篇 Markdown 吧。
				</p>
			) : (
				<div class="grid gap-4">
					{latest.map((post) => <PostCard post={post} />)}
				</div>
			)
		}
	</section>
</BaseLayout>
