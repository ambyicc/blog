---
import { render } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../consts';
import { formatDate, getPublishedPosts, getReadingTime, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: posts[index - 1] ?? null,
			older: posts[index + 1] ?? null,
		},
	}));
}

interface Props {
	post: Post;
	newer: Post | null;
	older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = getReadingTime(post);
---
<BaseLayout title={title} description={description} type="article">
	<div class="mx-auto max-w-6xl px-4 py-10 lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-12">
		<article class="min-w-0" data-pagefind-body>
			<header class="border-b border-zinc-200 pb-6 dark:border-zinc-800">
				<div
					class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400"
				>
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					<span aria-hidden="true">·</span>
					<span>{minutes} 分钟阅读</span>
					{
						updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<span>更新于 {formatDate(updatedDate)}</span>
							</>
						)
					}
				</div>

				<h1
					class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50"
					data-pagefind-meta="title"
				>
					{title}
				</h1>

				<p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

				{
					tags.length > 0 && (
						<ul class="mt-4 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<li>
									<a
										href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
										class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700"
									>
										{tag}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</header>

			<div class="prose prose-zinc mt-8 dark:prose-invert">
				<Content />
			</div>

			<nav
				class="mt-12 grid gap-4 border-t border-zinc-200 pt-6 text-sm sm:grid-cols-2 dark:border-zinc-800"
				aria-label="文章导航"
				data-pagefind-ignore
			>
				{
					newer ? (
						<a
							href={withBase(`/posts/${newer.id}/`)}
							class="rounded-lg border border-zinc-200 p-4 transition-colors hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900/40"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">上一篇</span>
							<span class="mt-1 block font-medium text-zinc-900 dark:text-zinc-100">
								{newer.data.title}
							</span>
						</a>
					) : (
						<span />
					)
				}
				{
					older && (
						<a
							href={withBase(`/posts/${older.id}/`)}
							class="rounded-lg border border-zinc-200 p-4 text-right transition-colors hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900/40"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">下一篇</span>
							<span class="mt-1 block font-medium text-zinc-900 dark:text-zinc-100">
								{older.data.title}
							</span>
						</a>
					)
				}
			</nav>
		</article>

		<aside class="hidden lg:block" data-pagefind-ignore>
			<div class="sticky top-24">
				<TableOfContents headings={headings} />
			</div>
		</aside>
	</div>

	<script>
		// 给每个代码块加一个复制按钮
		for (const pre of document.querySelectorAll('pre.astro-code')) {
			const wrapper = document.createElement('div');
			wrapper.className = 'code-block';
			pre.replaceWith(wrapper);
			wrapper.appendChild(pre);

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'copy-code';
			button.textContent = '复制';
			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(pre.textContent ?? '');
					button.textContent = '已复制';
				} catch {
					button.textContent = '复制失败';
				}
				window.setTimeout(() => {
					button.textContent = '复制';
				}, 1500);
			});
			wrapper.appendChild(button);
		}
	</script>
</BaseLayout>
