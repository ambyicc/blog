---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---
<BaseLayout title="文章" description="全部已发布文章">
	<section class="mx-auto max-w-5xl px-4 py-12">
		<header class="mb-8 border-b border-zinc-200 pb-6 dark:border-zinc-800">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">文章</h1>
			<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">共 {posts.length} 篇</p>
		</header>

		<div class="grid gap-4">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
