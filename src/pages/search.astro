---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE_PATH } from '../consts';

const bundlePath = `${BASE_PATH}/pagefind/`;
---
<BaseLayout title="搜索" description="搜索全站文章">
	<section class="mx-auto max-w-3xl px-4 py-12">
		<h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">搜索</h1>
		<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
			输入关键词，搜索文章标题与正文。索引在构建时生成。
		</p>

		<div id="search" class="mt-8"></div>

		<noscript>
			<p class="mt-4 text-sm text-zinc-500">搜索需要启用 JavaScript。</p>
		</noscript>
	</section>

	<link slot="head" rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />

	<script is:inline define:vars={{ bundlePath }}>
		const script = document.createElement('script');
		script.src = `${bundlePath}pagefind-ui.js`;
		script.onload = () => {
			new window.PagefindUI({
				element: '#search',
				bundlePath,
				showSubResults: true,
				translations: {
					placeholder: '搜索文章…',
					zero_results: '没有找到与 [SEARCH_TERM] 相关的结果',
				},
			});
		};
		document.head.appendChild(script);
	</script>
</BaseLayout>
